
NODE_ENV=development
APP_NAME=whatsapp-driver-baileys-local
APP_PORT=3000
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host ports are separate from the existing docker-compose.yml stack.
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=whatsapp_local
DB_PASSWORD=whatsapp_local_password
DB_ROOT_PASSWORD=whatsapp_local_root_password
DB_NAME=whatsapp_driver_local
DB_SHADOW_NAME=whatsapp_driver_local_shadow
DB_CONNECTION_LIMIT=10

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=whatsapp_local_redis_password
REDIS_DB=0

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=whatsapp_local
MINIO_SECRET_KEY=whatsapp_local_minio_password
MINIO_BUCKET=whatsapp-local-media

WA_ADMIN_API_KEY=whatsapp-local-development-admin-key-2026
WA_MAX_SESSIONS=10
WA_STARTUP_CONCURRENCY=2
WA_STARTUP_STAGGER_MS=1000
WA_WATCHDOG_INTERVAL_MS=10000
WA_CONNECTION_STUCK_MS=60000
WA_STABLE_CONNECTION_MS=30000
WA_PAIRING_TTL_MS=60000
WA_PAIRING_CODE_TTL_MS=180000
WA_PAIRING_RATE_LIMIT_MS=10000

# A blank URL disables APM for local development.
ELASTIC_APM_SERVICE_NAME=whatsapp-driver-baileys-local
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=

MYSQL_DOCKER_IMAGE=public.ecr.aws/docker/library/mysql:8.4 
REDIS_DOCKER_IMAGE=public.ecr.aws/docker/library/redis:7
MINIO_DOCKER_IMAGE=public.ecr.aws/y9w4h2u9/minio:RELEASE.2025-09-07T16-13-09Z
