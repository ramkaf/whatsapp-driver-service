NODE_ENV=development
APP_NAME=boilerplate
# APP_PORT takes precedence over PORT. The fallback is 3000.
APP_PORT=3000
# PORT=3000
# Optional frontend URL; also used as the default CORS origin when set.
# FRONTEND_DOMAIN=http://localhost:5173
BACKEND_DOMAIN=http://localhost:3000
# Comma-separated origins, or * to allow all origins.
APP_CORS_ORIGINS=http://localhost:5173
# Set to an empty value to serve routes without a prefix.
API_PREFIX=api



ELASTIC_APM_SECRET_TOKEN=test
ELASTIC_APM_SERVICE_NAME=test
ELASTIC_APM_SERVER_URL=https://apm.test.com
# RabbitMQModule is registered in AppModule; initialization runs automatically.
# localhost is for local development; set the broker hostname for deployment.
RABBITMQ_URL=amqp://localhost:5672?heartbeat=30
# Deploy the same read-only JSON file/version to every microservice.
RABBITMQ_TOPOLOGY_PATH=config/rabbitmq.topology.json


#################################################################################################
###################################       MySQL / Prisma   #######################################
#################################################################################################
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="TODO change it"
DB_CONNECTION_LIMIT="10"


#################################################################################################
###################################       Redis   #######################################
#################################################################################################
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Default logical database; individual operations can override it.
REDIS_DB=0


#################################################################################################
########################################   MINIO   ############################################
#################################################################################################
MINIO_ENDPOINT="localhost"
MINIO_PORT=9005
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="supersecretpassword"
MINIO_BUCKET="main"
