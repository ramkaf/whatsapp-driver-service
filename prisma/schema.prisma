generator client {
  provider               = "prisma-client"
  output                 = "./generated/prisma"
  previewFeatures        = ["views"]
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Case {
  id                      BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  caseNumber              String                  @unique(map: "uq_case_number") @db.VarChar(60)
  caseType                Case_caseType
  status                  Case_status             @default(DRAFT)
  sourceGroupId           BigInt?                 @db.UnsignedBigInt
  sourceGroupAssignmentId BigInt?                 @db.UnsignedBigInt
  createdBy               BigInt                  @db.UnsignedBigInt
  updatedBy               BigInt?                 @db.UnsignedBigInt
  currentRevisionId       BigInt?                 @db.UnsignedBigInt
  title                   String?                 @db.VarChar(255)
  description             String?                 @db.Text
  submittedAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now())
  CaseAccountingRequest   CaseAccountingRequest[]
  CaseAiRun               CaseAiRun[]
  CaseApproval            CaseApproval[]
  CaseComment             CaseComment[]
  CaseMessage             CaseMessage[]
  CaseParticipant         CaseParticipant[]
  CaseRevision            CaseRevision[]
  CaseStatusHistory       CaseStatusHistory[]

  @@index([createdBy], map: "idx_case_created_by")
  @@index([sourceGroupId], map: "idx_case_source_group")
  @@index([status, createdAt], map: "idx_case_status_created")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseAccountingRequest {
  id                  BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  caseId              BigInt                       @db.UnsignedBigInt
  revisionId          BigInt                       @db.UnsignedBigInt
  operationId         String                       @unique(map: "uq_case_accounting_operation") @db.Char(36)
  status              CaseAccountingRequest_status @default(PENDING)
  requestedBy         BigInt                       @db.UnsignedBigInt
  accountingRequestId String?                      @unique(map: "uq_case_accounting_external_request") @db.VarChar(120)
  externalDocumentId  String?                      @db.VarChar(150)
  attemptCount        Int                          @default(0) @db.UnsignedInt
  lastError           String?                      @db.Text
  requestedAt         DateTime                     @default(now())
  completedAt         DateTime?
  updatedAt           DateTime                     @default(now())
  Case                Case                         @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_accounting_case")
  CaseRevision        CaseRevision                 @relation(fields: [caseId, revisionId], references: [caseId, id], onUpdate: NoAction, map: "fk_case_accounting_revision")

  @@index([caseId, revisionId], map: "fk_case_accounting_revision")
  @@index([caseId], map: "idx_case_accounting_case")
  @@index([status, requestedAt], map: "idx_case_accounting_status")
}

model CaseAiRun {
  id                                                           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  caseId                                                       BigInt           @db.UnsignedBigInt
  requestId                                                    String           @unique(map: "uq_case_ai_request") @db.Char(36)
  status                                                       CaseAiRun_status @default(QUEUED)
  requestedBy                                                  BigInt           @db.UnsignedBigInt
  inputRevisionId                                              BigInt?          @db.UnsignedBigInt
  outputRevisionId                                             BigInt?          @db.UnsignedBigInt
  modelName                                                    String?          @db.VarChar(150)
  errorMessage                                                 String?          @db.Text
  requestedAt                                                  DateTime         @default(now())
  startedAt                                                    DateTime?
  finishedAt                                                   DateTime?
  Case                                                         Case             @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_ai_case")
  CaseRevision_CaseAiRun_caseId_inputRevisionIdToCaseRevision  CaseRevision?    @relation("CaseAiRun_caseId_inputRevisionIdToCaseRevision", fields: [caseId, inputRevisionId], references: [caseId, id], onUpdate: NoAction, map: "fk_case_ai_input_revision")
  CaseRevision_CaseAiRun_caseId_outputRevisionIdToCaseRevision CaseRevision?    @relation("CaseAiRun_caseId_outputRevisionIdToCaseRevision", fields: [caseId, outputRevisionId], references: [caseId, id], onUpdate: NoAction, map: "fk_case_ai_output_revision")

  @@index([caseId, inputRevisionId], map: "fk_case_ai_input_revision")
  @@index([caseId, outputRevisionId], map: "fk_case_ai_output_revision")
  @@index([caseId, status], map: "idx_case_ai_case_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseApproval {
  id           BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  caseId       BigInt                @db.UnsignedBigInt
  revisionId   BigInt                @db.UnsignedBigInt
  decision     CaseApproval_decision
  decidedBy    BigInt                @db.UnsignedBigInt
  comment      String?               @db.Text
  decidedAt    DateTime              @default(now())
  Case         Case                  @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_approval_case")
  CaseRevision CaseRevision          @relation(fields: [caseId, revisionId], references: [caseId, id], onUpdate: NoAction, map: "fk_case_approval_revision")

  @@index([caseId, revisionId], map: "fk_case_approval_revision")
  @@index([caseId, decidedAt], map: "idx_case_approval_case")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseComment {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  caseId    BigInt   @db.UnsignedBigInt
  authorId  BigInt   @db.UnsignedBigInt
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Case      Case     @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_comment_case")

  @@index([caseId, createdAt], map: "idx_case_comment_case")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseMessage {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  caseId           BigInt   @db.UnsignedBigInt
  messageId        BigInt   @db.UnsignedBigInt
  messageVersionId BigInt   @db.UnsignedBigInt
  groupId          BigInt   @db.UnsignedBigInt
  selectedBy       BigInt   @db.UnsignedBigInt
  selectedAt       DateTime @default(now())
  position         Int      @default(0) @db.UnsignedInt
  createdAt        DateTime @default(now())
  Case             Case     @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_message_case")

  @@unique([caseId, messageId], map: "uq_case_message")
  @@index([messageVersionId], map: "idx_case_message_version")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseParticipant {
  id              BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  caseId          BigInt                          @db.UnsignedBigInt
  customerId      BigInt                          @db.UnsignedBigInt
  participantRole CaseParticipant_participantRole @default(COUNTERPARTY)
  createdAt       DateTime                        @default(now())
  Case            Case                            @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_participant_case")

  @@unique([caseId, customerId], map: "uq_case_participant")
  @@index([customerId], map: "idx_case_participant_customer")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseRevision {
  id                                                        BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  caseId                                                    BigInt                  @db.UnsignedBigInt
  revisionNumber                                            Int                     @db.UnsignedInt
  source                                                    CaseRevision_source
  data                                                      Json
  schemaVersion                                             String                  @default("1") @db.VarChar(40)
  changeReason                                              String?                 @db.VarChar(1000)
  createdBy                                                 BigInt?                 @db.UnsignedBigInt
  createdAt                                                 DateTime                @default(now())
  CaseAccountingRequest                                     CaseAccountingRequest[]
  CaseAiRun_CaseAiRun_caseId_inputRevisionIdToCaseRevision  CaseAiRun[]             @relation("CaseAiRun_caseId_inputRevisionIdToCaseRevision")
  CaseAiRun_CaseAiRun_caseId_outputRevisionIdToCaseRevision CaseAiRun[]             @relation("CaseAiRun_caseId_outputRevisionIdToCaseRevision")
  CaseApproval                                              CaseApproval[]
  Case                                                      Case                    @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_revision_case")

  @@unique([caseId, revisionNumber], map: "uq_case_revision")
  @@unique([caseId, id], map: "uq_case_revision_identity")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CaseStatusHistory {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  caseId     BigInt   @db.UnsignedBigInt
  fromStatus String?  @db.VarChar(40)
  toStatus   String   @db.VarChar(40)
  changedBy  BigInt?  @db.UnsignedBigInt
  reason     String?  @db.VarChar(1000)
  changedAt  DateTime @default(now())
  Case       Case     @relation(fields: [caseId], references: [id], onUpdate: NoAction, map: "fk_case_status_history_case")

  @@index([caseId, changedAt], map: "idx_case_status_history")
}

model InboxEvent {
  id           BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  consumerName String            @db.VarChar(120)
  eventId      String            @db.Char(36)
  eventType    String            @db.VarChar(120)
  status       InboxEvent_status @default(PROCESSING)
  attemptCount Int               @default(0) @db.UnsignedInt
  lastError    String?           @db.Text
  receivedAt   DateTime          @default(now())
  processedAt  DateTime?

  @@unique([consumerName, eventId], map: "uq_inbox_consumer_event")
  @@index([status, receivedAt], map: "idx_inbox_status")
}

model OutboxEvent {
  id            BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  eventId       String             @unique(map: "uq_outbox_event_id") @db.Char(36)
  aggregateType String             @db.VarChar(80)
  aggregateId   String             @db.VarChar(120)
  eventType     String             @db.VarChar(120)
  routingKey    String             @db.VarChar(150)
  payload       Json
  status        OutboxEvent_status @default(PENDING)
  attemptCount  Int                @default(0) @db.UnsignedInt
  nextAttemptAt DateTime?
  lockedBy      String?            @db.VarChar(120)
  lockedUntil   DateTime?
  lastError     String?            @db.Text
  createdAt     DateTime           @default(now())
  publishedAt   DateTime?

  @@index([aggregateType, aggregateId], map: "idx_outbox_aggregate")
  @@index([status, nextAttemptAt, lockedUntil, createdAt], map: "idx_outbox_dispatch")
}

view case_view {
  id         BigInt             @default(0) @db.UnsignedBigInt
  caseNumber String             @db.VarChar(60)
  caseType   case_view_caseType
}

enum Case_caseType {
  EXCHANGE
  SETTLEMENT
  OFFSET
  OTHER
}

enum case_view_caseType {
  EXCHANGE
  SETTLEMENT
  OFFSET
  OTHER
}

enum Case_status {
  DRAFT
  AI_PENDING
  AI_PROCESSING
  REVIEW_REQUIRED
  IN_REVIEW
  APPROVED
  REJECTED
  ACCOUNTING_PENDING
  ACCOUNTING_PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CaseAiRun_status {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CaseApproval_decision {
  APPROVED
  REJECTED
  RETURNED_FOR_REVISION
}

enum CaseParticipant_participantRole {
  PRIMARY
  COUNTERPARTY
  BENEFICIARY
  OTHER
}

enum CaseRevision_source {
  MANUAL
  AI
  IMPORT
}

enum CaseAccountingRequest_status {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
  CANCELLED
}

enum InboxEvent_status {
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxEvent_status {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}
