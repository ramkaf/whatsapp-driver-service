{
  "name": "boilerplate",
  "version": "0.0.3",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "up": "pnpm run up:local",
    "down": "pnpm run down:local",
    "docker:local": "docker compose --env-file .env.local -f docker-compose.yml",
    "docker:prod": "docker compose --env-file .env.prod -f docker-compose.yml",
    "up:local": "pnpm run docker:local up -d --wait",
    "down:local": "pnpm run docker:local down",
    "up:prod": "pnpm run docker:prod up -d --build --wait",
    "down:prod": "pnpm run docker:prod down",
    "logs:local": "pnpm run docker:local logs -f",
    "logs:prod": "pnpm run docker:prod logs -f",
    "start:local": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.local pnpm run start:dev",
    "build:local": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.local pnpm run build",
    "build:prod": "NODE_ENV=production DOTENV_CONFIG_PATH=.env.prod pnpm run build",
    "db:local": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.local prisma",
    "db:prod": "pnpm run docker:prod run --rm --build prisma",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\"",
    "start": "pnpm run start:local",
    "start:dev": "pnpm run db:generate && nest start --watch",
    "start:debug": "pnpm run db:generate && nest start --debug --watch",
    "start:prod": "NODE_ENV=production DOTENV_CONFIG_PATH=.env.prod node dist/main.js",
    "lint": "oxlint --type-aware src/ libs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "precommit": "pnpm run lint && pnpm run typecheck ",
    "prepush": "pnpm run precommit && pnpm test ",
    "prepare": "husky",
    "build": "pnpm run db:generate && nest build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull && prisma generate",
    "db-pull": "pnpm run db:pull",
    "db:migrate:create": "pnpm run db:local migrate dev --create-only",
    "db:migrate:deploy": "pnpm run db:prod migrate deploy",
    "db:migrate:dev": "pnpm run db:local migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.15",
    "minio": "^8.0.7",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "dotenv": "^18.0.9",
    "elastic-apm-node": "^4.18.0",
    "ioredis": "^6.0.0",
    "mariadb": "^3.5.5",
    "minio": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.22.1",
    "elastic-apm-node": "^4.18.0",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "husky": "^9.1.7",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
